#!/usr/bin/env bash
# Builds the installer for release on a Mac: one app for Apple silicon and Intel, signed with a
# Developer ID, in a disk image that's notarized by Apple and stapled, so it opens with no warning.
#
#   installer/tools/release-mac      makes build/bin/TouchStream-Installer-VERSION.dmg
#
# Needs Xcode, the Wails CLI and a "Developer ID Application" certificate in the keychain. To
# notarize, save your notarization credentials once, as a keychain profile:
#
#   xcrun notarytool store-credentials touchstream-notary --apple-id YOU@EXAMPLE.COM --team-id TEAMID
#
# (it asks for an app-specific password: make one at account.apple.com). SIGN_IDENTITY=... picks
# another certificate, NOTARY_PROFILE=... another profile, and NOTARIZE=0 only signs.
#
# Copyright (c) 2025 Will Reeves and TouchStream Contributors
# Licensed under the MIT License - see LICENSE file for details

set -euo pipefail

INSTALLER="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$INSTALLER"
say() { printf '\033[1m==>\033[0m %s\n' "$*"; }
die() { printf '\033[31mError:\033[0m %s\n' "$*" >&2; exit 1; }

VERSION="$(sed -n 's/^const Version = "\(.*\)"/\1/p' main.go)"
IDENTITY="${SIGN_IDENTITY:-$(security find-identity -v -p codesigning | sed -n 's/.*"\(Developer ID Application: [^"]*\)".*/\1/p' | head -1)}"
PROFILE="${NOTARY_PROFILE:-touchstream-notary}"
WAILS="$(command -v wails || echo "$HOME/go/bin/wails")"
APP="build/bin/TouchStream Installer.app"
DMG="build/bin/TouchStream-Installer-$VERSION.dmg"
[ -n "$IDENTITY" ] || die "There's no Developer ID Application certificate in the keychain"
[ -x "$WAILS" ] || die "Install the Wails CLI: go install github.com/wailsapp/wails/v2/cmd/wails@v2.17.1"

if [ "${NOTARIZE:-1}" != 0 ] && ! xcrun notarytool history --keychain-profile "$PROFILE" >/dev/null 2>&1; then
    die "No notarization profile \"$PROFILE\" in the keychain: see the top of this script (or NOTARIZE=0)"
fi

say "Building $VERSION for Apple silicon and Intel"
"$WAILS" build -platform darwin/universal -skipbindings -clean -trimpath >/dev/null

# The hardened runtime is what notarization asks for; the installer needs no exceptions to it
say "Signing as $IDENTITY"
codesign --force --options runtime --timestamp --sign "$IDENTITY" "$APP"
codesign --verify --strict "$APP"

say "Making the disk image"
stage="$(mktemp -d)"
trap 'rm -rf "$stage"' EXIT
cp -R "$APP" "$stage/"
rm -f "$DMG"
hdiutil create -quiet -volname "TouchStream Installer" -srcfolder "$stage" -format UDZO "$DMG"
codesign --force --timestamp --sign "$IDENTITY" "$DMG"

if [ "${NOTARIZE:-1}" = 0 ]; then
    say "Signed, not notarized: $DMG"
    exit 0
fi
say "Notarizing (Apple checks it; this takes a few minutes)"
out="$(xcrun notarytool submit "$DMG" --keychain-profile "$PROFILE" --wait 2>&1)" || true
echo "$out" | grep -E "^\s*(id|status):" | head -2
if ! echo "$out" | grep -q "status: Accepted"; then
    id="$(echo "$out" | sed -n 's/^ *id: //p' | head -1)"
    [ -n "$id" ] && xcrun notarytool log "$id" --keychain-profile "$PROFILE" >&2
    die "Apple didn't accept it (its log is above)"
fi
xcrun stapler staple -q "$DMG"
spctl --assess --type open --context context:primary-signature "$DMG"
say "Ready: $DMG"
