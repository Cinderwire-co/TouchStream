#!/usr/bin/env bash
# TouchStream Lite dev helper: build the spoke and run it in an emulated PicoKVM.
#
#   tools/dev build          cross-compile for the PicoKVM (linux/arm/v7, static) into build/
#   tools/dev test           run the tests
#   tools/dev clip           make the emulator's test clip (1080p30 H.264 + a 440 Hz tone), once
#   tools/dev emulate        build, then run it in an ARMv7 container held to the PicoKVM's
#                            1 core and 256 MB, replaying the clip as its "HDMI input"
#   tools/dev pair HUB CODE  pair the emulated spoke with a hub (CODE from Add spoke)
#   tools/dev logs           follow the emulator's log
#   tools/dev stop           stop the emulator
#
# The emulator keeps its settings and recordings in .emulator/ (git-ignored), like the card in
# the real box. Needs Go and Docker Desktop. ADDRESS=... sets the address phones use for it.
#
# Copyright (c) 2025 Will Reeves and TouchStream Contributors
# Licensed under the MIT License - see LICENSE file for details

set -euo pipefail

LITE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
NAME=touchstream-lite-emulator
IMAGE=touchstream-lite-emulator
CLIP="$LITE/testdata/clip.ts"

build() {
    mkdir -p "$LITE/build"
    (cd "$LITE" && GOOS=linux GOARCH=arm GOARM=7 CGO_ENABLED=0 \
        go build -trimpath -ldflags "-s -w" -o build/touchstream-lite ./cmd/touchstream-lite)
    echo "Built build/touchstream-lite ($(du -h "$LITE/build/touchstream-lite" | cut -f1))"
}

clip() {
    mkdir -p "$LITE/testdata"
    # What the RV1106's encoder will send: High profile, a keyframe every 2 s, AAC stereo
    ffmpeg -hide_banner -loglevel error -y \
        -f lavfi -i testsrc2=size=1920x1080:rate=30 -f lavfi -i "sine=frequency=440:sample_rate=48000" -t 30 \
        -c:v libx264 -profile:v high -level 4 -preset veryfast -pix_fmt yuv420p \
        -b:v 6M -maxrate 6M -bufsize 6M -g 60 -keyint_min 60 -sc_threshold 0 \
        -c:a aac -b:a 192k -ac 2 -af volume=0.1 -f mpegts "$CLIP"
    echo "Made testdata/clip.ts ($(du -h "$CLIP" | cut -f1))"
}

run_in() { docker exec "$NAME" /opt/touchstream/touchstream-lite "$1" -data /userdata/touchstream "${@:2}"; }

case "${1:-}" in
    build) build ;;
    test) (cd "$LITE" && go vet ./... && go test ./...) ;;
    clip) clip ;;
    emulate)
        build
        [ -f "$CLIP" ] || clip
        mkdir -p "$LITE/.emulator"
        docker image inspect "$IMAGE" >/dev/null 2>&1 ||
            docker build -q --platform linux/arm/v7 -t "$IMAGE" "$LITE/tools/emulator" >/dev/null
        # Phones reach the emulator at this computer's address, not the container's
        address="${ADDRESS:-$(ipconfig getifaddr en0 2>/dev/null || ipconfig getifaddr en1 2>/dev/null || hostname -I | cut -d' ' -f1)}"
        tz="$(readlink /etc/localtime | sed 's|.*zoneinfo/||')"
        docker rm -f "$NAME" >/dev/null 2>&1 || true
        docker run -d --name "$NAME" --platform linux/arm/v7 --hostname picokvm-emulator \
            --cpus 1 --memory 256m --memory-swap 256m -p 6077:6077 -e TZ="${tz:-UTC}" \
            -v "$LITE/build:/opt/touchstream:ro" -v "$CLIP:/opt/clip.ts:ro" -v "$LITE/.emulator:/userdata" \
            "$IMAGE" /opt/touchstream/touchstream-lite run -data /userdata/touchstream -source replay:/opt/clip.ts \
            -address "$address" >/dev/null
        echo "Emulator running. Its screen: http://localhost:6077/screen (from a phone: http://$address:6077/screen)"
        ;;
    pair) shift; run_in pair "$@" ;;
    logs) docker logs -f "$NAME" ;;
    stop) docker rm -f "$NAME" >/dev/null && echo "Emulator stopped" ;;
    *) sed -n '2,15p' "$0"; exit 1 ;;
esac
