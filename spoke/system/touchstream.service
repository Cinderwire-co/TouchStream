# TouchStream kiosk: runs the spoke app full screen under the cage Wayland
# compositor on tty1, in place of the desktop's display manager.
[Unit]
Description=TouchStream Spoke kiosk
After=systemd-user-sessions.service plymouth-quit-wait.service dbus.socket systemd-logind.service
Wants=dbus.socket systemd-logind.service
Conflicts=getty@tty1.service
After=getty@tty1.service touchstream-edid.service

[Service]
Type=simple
User=@USER@
WorkingDirectory=@INSTALL_DIR@
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
# The PAM session moves the app into a session scope, so tag its log lines
# (journalctl -t touchstream) rather than relying on the unit name
SyslogIdentifier=touchstream
UtmpIdentifier=tty1
UtmpMode=user
Environment=XDG_SESSION_TYPE=wayland
Environment=SDL_VIDEODRIVER=wayland
# Start even if the touchscreen is missing, so the preview still works
Environment=WLR_LIBINPUT_NO_DEVICES=1
Environment=PYTHONUNBUFFERED=1
# Fully transparent cursor theme: the SPI panel has no hardware cursor plane,
# so the compositor would otherwise draw a pointer over the app
Environment=XCURSOR_PATH=/usr/share/touchstream/cursors XCURSOR_THEME=default XCURSOR_SIZE=24
ExecStart=/usr/bin/cage -d -s -- /usr/bin/python3 @INSTALL_DIR@/touchstream-spoke.py
Restart=always
RestartSec=2

[Install]
WantedBy=graphical.target
Alias=display-manager.service
