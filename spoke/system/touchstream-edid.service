[Unit]
Description=TouchStream: tell HDMI sources which 1080p frame rate to send (EDID)
After=systemd-modules-load.service
Before=touchstream.service

[Service]
Type=oneshot
WorkingDirectory=@INSTALL_DIR@
# The capture card forgets its EDID on power loss; load the rate set in the hub
ExecStart=/usr/bin/python3 -m touchstream.edid --apply --config @HOME@/stream-config.json
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
